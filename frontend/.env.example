# SAKSHYA frontend — local/offline demo configuration.
# The frontend has NO secrets: no passwords, no private keys, no tokens here.
# (Vite VITE_* variables are bundled into client JS — never put secrets in them.)

# Local backend for `npm run dev` (backend/main.py defaults to 127.0.0.1:8100).
# If unset, src/api.js falls back to http://127.0.0.1:8100/api automatically.
VITE_API_BASE_URL=http://127.0.0.1:8100/api

# Inside Docker this is overridden at build time to /api (same-origin nginx
# proxy, see docker-compose.yml + docker/nginx.conf) — do not change that.
