# SAKSHYA backend environment — copy nothing, set only what you need.
# The backend runs with safe defaults for a local/offline SIH demo.
# NEVER put secrets in this file. The master key is DERIVED from an operator password (PBKDF2-SHA256,
# 600k iterations) - nothing is auto-generated or written to .env any more.

# --- Server (backend/main.py defaults: 127.0.0.1:8100) ---
# SAKSHYA_HOST=127.0.0.1
# SAKSHYA_PORT=8100
# SAKSHYA_RELOAD=0
# SAKSHYA_APP_ENV=development   # set "production" for the SIH demo (clean JSON errors, no tracebacks)

# --- Local data (SQLite + files; nothing cloud) ---
# SAKSHYA_STORAGE_DIR=../storage
# SAKSHYA_DATABASE_URL=sqlite:///../storage/sakshya.db
# SAKSHYA_ENV_FILE=../.env

# --- CORS: explicit local origins only (comma-separated, never "*") ---
# SAKSHYA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- Upload + ledger ---
# SAKSHYA_MAX_UPLOAD_MB=25
# SAKSHYA_LEDGER_NODES=3

# --- Master password (key ceremony; see README) - supply ONE of: ---
# SAKSHYA_MASTER_PASSWORD_FILE=/media/usb/sakshya-master.pw   # preferred: offline file, chmod 600
# SAKSHYA_MASTER_PASSWORD=...                                 # discouraged (visible in process env)
# (or start the backend from an interactive terminal and type it)
# SAKSHYA_MASTER_KEY is IGNORED.

# --- Ledger nodes ---
# SAKSHYA_LEDGER_DIR=../storage/ledger      # ledger-node1.db, ledger-node2.db, ledger-node3.db
# SAKSHYA_LEDGER_STRICT=0                   # 1 => investigations need ALL nodes healthy, not just a 2/3 majority

# --- Dev only, NEVER production ---
# SAKSHYA_ALLOW_FALLBACK=true               # allow classical X25519/Ed25519 if cryptography<48
